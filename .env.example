# Copy this file to your own local env file if you want a starting point
# for running the samples. Do not commit real credentials or secrets.

# Common sample configuration
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_KEY=hello.txt
AWS_S3_REGION=us-east-2

# Text upload sample
AWS_S3_CONTENT=hello from aws s3 java samples
AWS_S3_CREATE_BUCKET=false
AWS_S3_CLEANUP=false

# File upload sample
AWS_S3_FILE=/absolute/path/to/local-file.txt
AWS_S3_MULTIPART_THRESHOLD=5242880

# Optional named AWS profile for download or local runs
AWS_PROFILE=default

# Integration test configuration
AWS_S3_INTEGRATION_BUCKET=your-s3-bucket
AWS_S3_INTEGRATION_REGION=us-east-2
AWS_S3_INTEGRATION_PROFILE=default
